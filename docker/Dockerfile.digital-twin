FROM python:3.14.2-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-digital-twin.txt /app/
RUN pip install --no-cache-dir -r requirements-digital-twin.txt
COPY src /app/src
ENV PYTHONPATH=/app/src
RUN useradd --create-home --uid 10001 lpr && mkdir -p /data && chown -R lpr:lpr /app /data
USER 10001
