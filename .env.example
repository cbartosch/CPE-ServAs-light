# LPR CPE Service Assurance demonstration defaults.
# Safe by default: every operational integration is simulated and production writes are disabled.
COMPOSE_PROJECT_NAME=lpr-cpe-demo
APP_ENVIRONMENT=docker
APPLICATION_MODE=simulation
PRODUCTION_WRITES_ENABLED=false
DEMO_AUTH_ENABLED=false
DEMO_DEFAULT_USER=demo.operator
DEMO_DEFAULT_ROLE=operations_supervisor

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=lpr
POSTGRES_PASSWORD=lpr_demo_change_me
POSTGRES_DB=lpr_cpe_demo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lpr:lpr_demo_change_me@postgres:5432/lpr_cpe_demo
LANGGRAPH_POSTGRES_DSN=postgresql://lpr:lpr_demo_change_me@postgres:5432/lpr_cpe_demo
LANGGRAPH_STRICT_MSGPACK=true

API_PORT=8000
UI_PORT=8501
MCP_PORT=8100
API_URL=http://api:8000
MCP_URL=http://mcp-sim:8100/mcp
MCP_PROFILE=custom_stateless_2026
MCP_HEALTH_URL=http://mcp-sim:8100/health
MCP_USE_NETWORK=true
MCP_PROTOCOL_VERSION=2026-07-28
MCP_STRICT_VERSION=true
MCP_APPROVAL_SIGNING_SECRET=change-me-demo-signing-secret
MCP_EFFECT_DB=./data/mcp_effects.db

USE_LANGGRAPH=true
WORKFLOW_ENGINE=langgraph
LANGGRAPH_FALLBACK_ALLOWED=false
MODEL_PROVIDER=fake
MODEL_NAME=fake-lpr-cpe-v1
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=1200
MODEL_TEMPERATURE=0
MODEL_FALLBACK_ALLOWED=true
MODEL_BASE_URL=
MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Either switch set to fake forces the fake provider for BOTH the RCA assistant
# and the decision agents, even when a key is present. That is deliberate: a demo
# that meant to stay offline should stay offline.
LLM_PROVIDER=fake

RCA_CONFIDENCE_THRESHOLD=0.70
MAX_REMOTE_ATTEMPTS=2
MAX_FIELD_VISITS=3
MAX_MR_ATTEMPTS=2
MAX_DIAGNOSTIC_CYCLES=4
GRAPH_MAX_STEPS=40
STABILITY_WINDOW_MINUTES=15
UI_REFRESH_SECONDS=2

LOG_LEVEL=INFO
TZ=America/Puerto_Rico

# Optional build connectivity settings. Prefer an internal package mirror when available.
# TLS verification remains enabled; stage a corporate CA in docker/certs when HTTPS is re-signed.
PIP_INDEX_URL=

# --- dispatch route geometry -----------------------------------------------
# straight : two-point legs, no network. Travel minutes still come from the
#            archetype road-speed model, so only the drawn line is a schematic.
# osrm     : real road geometry from an OSRM endpoint. Ferry legs are never
#            road-routed; only the land leg to the terminal is sent.
# --- base image -------------------------------------------------------------
# The Docker DAEMON pulls this before any build layer runs, so the CA staged into
# docker/certs/ is NOT reached. On a network that intercepts TLS the pull fails
# with "certificate signed by unknown authority" and no amount of in-image fixing
# helps. Point this at an internal mirror to avoid the public registry:
#   BASE_IMAGE=artifactory.example.com/docker-remote/python:3.12-slim
BASE_IMAGE=python:3.12-slim

ROUTING_PROVIDER=straight
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT=8
# Optional on-disk route cache. The public OSRM demo server has a usage policy
# that discourages repeated identical requests.
OSRM_CACHE_DIR=

# --- GUI artwork ------------------------------------------------------------
# Original SVG landmark motif in the header band and as a corner watermark.
# Set to off if it distracts; readability is unaffected either way.
UI_ARTWORK=on
